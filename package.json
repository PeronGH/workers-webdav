{
	"name": "workers-webdav",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"mint": "bun scripts/mint.ts",
